# Atlas: transient, single-use files (approval records, locks). Never committed.
.atlas-tmp/
# Marks the maintainer's own copy of the upstream repo (hooks bypass only with it). Never committed.
.atlas-maintainer
# OS and editor clutter
.DS_Store
Thumbs.db
__pycache__/
*.pyc
# Chat attachments wait here untracked until filed under the user's data rules (never enter history unfiltered).
user/inbox/drop/*
!user/inbox/drop/.gitkeep
